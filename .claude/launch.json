{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kbox",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "kbox.main"],
      "port": 8000
    },
    {
      "name": "kbox-scratch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run", "python", "-m", "kbox.main",
        "--data-dir", ".kbox-scratch",
        "--access-token", "uxtest"
      ],
      "port": 8000
    }
  ]
}
